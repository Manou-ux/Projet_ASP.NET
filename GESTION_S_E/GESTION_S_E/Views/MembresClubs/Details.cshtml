@model GESTION_S_E.Models.MembreClub
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Détails du membre";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Détails du membre</h4>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">Utilisateur</dt>
                        <dd class="col-sm-8">@(Model.Utilisateur?.Email ?? "N/A")</dd>

                        <dt class="col-sm-4">Club</dt>
                        <dd class="col-sm-8">@(Model.Club?.NomClub ?? "N/A")</dd>

                        <dt class="col-sm-4">Rôle</dt>
                        <dd class="col-sm-8">
                            <span class="badge @(Model.RoleMembre == "president" ? "bg-danger" : (Model.RoleMembre == "vice-president" ? "bg-warning" : "bg-info"))">
                                @Model.RoleMembre
                            </span>
                        </dd>

                        <dt class="col-sm-4">Date d'adhésion</dt>
                        <dd class="col-sm-8">@Model.DateAdhesion.ToString("dd/MM/yyyy HH:mm")</dd>
                    </dl>
                </div>
                <div class="card-footer">
                    <a asp-action="Edit" asp-route-idUtilisateur="@Model.IdUtilisateur" asp-route-idClub="@Model.IdClub" class="btn btn-warning">
                        <i class="fas fa-edit"></i> Modifier
                    </a>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Retour
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>