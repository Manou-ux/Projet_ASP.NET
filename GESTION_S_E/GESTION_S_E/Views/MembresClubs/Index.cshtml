@model IEnumerable<GESTION_S_E.Models.MembreClub>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Gestion des Membres des Clubs";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Gestion des Membres des Clubs</h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus"></i> Ajouter un membre
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Utilisateur</th>
                            <th>Club</th>
                            <th>Rôle</th>
                            <th>Date d'adhésion</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@(item.Utilisateur?.Email ?? "N/A")</strong>
                                </td>
                                <td>@(item.Club?.NomClub ?? "N/A")</td>
                                <td>
                                    <span class="badge @(item.RoleMembre == "president" ? "bg-danger" : (item.RoleMembre == "vice-president" ? "bg-warning" : "bg-info"))">
                                        @item.RoleMembre
                                    </span>
                                </td>
                                <td>@item.DateAdhesion.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <a asp-action="Edit" asp-route-idUtilisateur="@item.IdUtilisateur" asp-route-idClub="@item.IdClub" class="btn btn-warning btn-sm">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-idUtilisateur="@item.IdUtilisateur" asp-route-idClub="@item.IdClub" class="btn btn-danger btn-sm">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>