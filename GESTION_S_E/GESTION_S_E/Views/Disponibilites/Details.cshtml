@model GESTION_S_E.Models.DisponibiliteEnseignant
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Détails de la disponibilité";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0"><i class="fas fa-info-circle"></i> Détails de la disponibilité</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered">
                            <tr>
                                <th style="width: 40%;">ID</th>
                                <td>@Model.IdDispo</td>
                            </tr>
                            <tr>
                                <th>Enseignant</th>
                                <td>
                                    <strong>@Model.Enseignant?.NomEnseignant @Model.Enseignant?.PrenomEnseignant</strong>
                                    <br />
                                    <small class="text-muted">@Model.Enseignant?.Specialite</small>
                                </td>
                            </tr>
                            <tr>
                                <th>Email professionnel</th>
                                <td>@Model.Enseignant?.EmailPro</td>
                            </tr>
                            <tr>
                                <th>Téléphone</th>
                                <td>@Model.Enseignant?.TelephoneEnseignant</td>
                            </tr>
                            <tr>
                                <th>Jour</th>
                                <td>@Model.Jour</td>
                            </tr>
                            <tr>
                                <th>Heure début</th>
                                <td>@Model.HeureDebut.ToString(@"hh\:mm")</td>
                            </tr>
                            <tr>
                                <th>Heure fin</th>
                                <td>@Model.HeureFin.ToString(@"hh\:mm")</td>
                            </tr>
                            <tr>
                                <th>Type</th>
                                <td>
                                    <span class="badge @(Model.TypeDispo == "cours" ? "bg-primary" : Model.TypeDispo == "td" ? "bg-success" : Model.TypeDispo == "tp" ? "bg-info" : "bg-warning")">
                                        @(Model.TypeDispo == "cours" ? "📚 Cours" : Model.TypeDispo == "td" ? "📝 TD" : Model.TypeDispo == "tp" ? "🔬 TP" : "📅 Réunion")
                                    </span>
                                </td>
                            </tr>
                            <tr>
                                <th>Date spécifique</th>
                                <td>@(Model.DateSpecifique?.ToString("dd/MM/yyyy") ?? "Hebdomadaire (chaque semaine)")</td>
                            </tr>
                        </table>
                    </div>

                    <div class="d-flex gap-2 mt-3">
                        <a asp-action="Edit" asp-route-id="@Model.IdDispo" class="btn btn-warning flex-grow-1">
                            <i class="fas fa-edit"></i> Modifier
                        </a>
                        <a asp-action="Index" class="btn btn-secondary flex-grow-1">
                            <i class="fas fa-arrow-left"></i> Retour
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>