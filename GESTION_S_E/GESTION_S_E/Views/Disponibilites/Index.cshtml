@model IEnumerable<GESTION_S_E.Models.DisponibiliteEnseignant>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Gestion des Disponibilités";
}

<h1>Liste des Disponibilités</h1>

@if (TempData["Success"] != null)
{
    <div style="background-color: green; color: white; padding: 15px; margin-bottom: 20px; border-radius: 5px;">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div style="background-color: red; color: white; padding: 15px; margin-bottom: 20px; border-radius: 5px;">
        @TempData["Error"]
    </div>
}

<p>
    <a class="btn btn-primary" href="/Disponibilites/Create">Ajouter une disponibilité</a>
</p>

<div class="table-responsive mt-3">
    <table class="table table-striped table-bordered align-middle">
        <thead class="table-light">
            <tr>
                <th>Enseignant</th>
                <th>Spécialité</th>
                <th>Jour</th>
                <th>Heure début</th>
                <th>Heure fin</th>
                <th>Type</th>
                <th>Date spécifique</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Enseignant?.NomEnseignant @item.Enseignant?.PrenomEnseignant</td>
                    <td>@item.Enseignant?.Specialite</td>
                    <td>@item.Jour</td>
                    <td>@(item.HeureDebut != default ? item.HeureDebut.ToString(@"hh\:mm") : "-")</td>
                    <td>@item.HeureFin.ToString(@"hh\:mm")</td>
                    <td>@(item.TypeDispo == "cours" ? "Cours" : item.TypeDispo == "td" ? "TD" : item.TypeDispo == "tp" ? "TP" : "Réunion")</td>
                    <td>@(item.DateSpecifique?.ToString("dd/MM/yyyy") ?? "Hebdomadaire")</td>
                    <td class="text-end">
                        <div class="table-actions d-inline-flex gap-1">
                            <a class="btn btn-sm btn-outline-primary" href="/Disponibilites/Details/@item.IdDispo">Détails</a>
                            <a class="btn btn-sm btn-outline-secondary" href="/Disponibilites/Edit/@item.IdDispo">Modifier</a>
                            <a class="btn btn-sm btn-outline-danger" href="/Disponibilites/Delete/@item.IdDispo">Supprimer</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>