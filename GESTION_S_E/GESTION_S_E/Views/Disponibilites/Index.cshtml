@model IEnumerable<GESTION_S_E.Models.DisponibiliteEnseignant>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Gestion des Disponibilités";
}

<h1>Liste des Disponibilités</h1>

@if (TempData["Success"] != null)
{
    <div style="background-color: green; color: white; padding: 15px; margin-bottom: 20px; border-radius: 5px;">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div style="background-color: red; color: white; padding: 15px; margin-bottom: 20px; border-radius: 5px;">
        @TempData["Error"]
    </div>
}

<a href="/Disponibilites/Create">Ajouter une disponibilité</a>

<br /><br />

<table border="1" cellpadding="10" style="border-collapse: collapse;">
    <tr>
        <th>Enseignant</th>
        <th>Spécialité</th>
        <th>Jour</th>
        <th>Heure début</th>
        <th>Heure fin</th>
        <th>Type</th>
        <th>Date spécifique</th>
        <th>Actions</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Enseignant?.NomEnseignant @item.Enseignant?.PrenomEnseignant</td>
            <td>@item.Enseignant?.Specialite</td>
            <td>@item.Jour</td>
            <td>@(item.HeureDebut != default ? item.HeureDebut.ToString(@"hh\:mm") : "-")</td>
            <td>@item.HeureFin.ToString(@"hh\:mm")</td>
            <td>@(item.TypeDispo == "cours" ? "Cours" : item.TypeDispo == "td" ? "TD" : item.TypeDispo == "tp" ? "TP" : "Réunion")</td>
            <td>@(item.DateSpecifique?.ToString("dd/MM/yyyy") ?? "Hebdomadaire")</td>
            <td>
                <a href="/Disponibilites/Edit/@item.IdDispo">Modifier</a>
                |
                <a href="/Disponibilites/Delete/@item.IdDispo">Supprimer</a>
                |
                <a href="/Disponibilites/Details/@item.IdDispo">Détails</a>
            </td>
        </tr>
    }
</table>