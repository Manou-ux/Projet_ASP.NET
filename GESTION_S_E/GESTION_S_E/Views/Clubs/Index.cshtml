@model IEnumerable<GESTION_S_E.Models.Club>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Gestion des Clubs";
}

<h1>Liste des Clubs</h1>

@if (TempData["Success"] != null)
{
    <div style="background-color: green; color: white; padding: 15px; margin-bottom: 20px; border-radius: 5px;">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div style="background-color: red; color: white; padding: 15px; margin-bottom: 20px; border-radius: 5px;">
        @TempData["Error"]
    </div>
}

<a href="/Clubs/Create">Créer un nouveau club</a>

<br /><br />

<table border="1" cellpadding="10" style="border-collapse: collapse;">
    <tr>
        <th>Nom du Club</th>
        <th>Description</th>
        <th>Responsable</th>
        <th>Date Création</th>
        <th>Statut</th>
        <th>Actions</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.NomClub</td>
            <td>@(item.Description?.Length > 50 ? item.Description.Substring(0, 50) + "..." : item.Description)</td>
            <td>@(item.Responsable != null ? item.Responsable.Email : "Non assigné")</td>
            <td>@item.DateCreation.ToString("dd/MM/yyyy")</td>
            <td>@(item.Actif ? "Actif" : "Inactif")</td>
            <td>
                <a href="/Clubs/Edit/@item.IdClub">Modifier</a>
                |
                <a href="/Clubs/Delete/@item.IdClub">Supprimer</a>
                |
                <a href="#" onclick="showMembres(@item.IdClub, '@item.NomClub'); return false;">Membres</a>
            </td>
        </tr>
    }
</table>

<br />

<!-- Section des membres (cachée par défaut) -->
<div id="membresSection" style="display: none;">
    <h2>Membres du club : <span id="clubNom"></span></h2>

    <a href="#" onclick="showAddMembreForm(); return false;">Ajouter un membre</a>
    &nbsp;|&nbsp;
    <a href="#" onclick="hideMembres(); return false;">Fermer</a>

    <br /><br />

    <!-- Formulaire d'ajout (caché par défaut) -->
    <div id="addMembreForm" style="display: none;">
        <input type="hidden" id="clubIdForMembre" />

        <table>
            <tr>
                <td>Utilisateur :</td>
                <td>
                    <select id="utilisateurId">
                        <option value="">-- Sélectionner un utilisateur --</option>
                        @if (ViewBag.Utilisateurs != null)
                        {
                            foreach (var u in ViewBag.Utilisateurs)
                            {
                                <option value="@u.IdUtilisateur">@u.Email</option>
                            }
                        }
                    </select>
                </td>
            </tr>
            <tr>
                <td>Rôle :</td>
                <td>
                    <select id="roleMembre">
                        <option value="membre">Membre</option>
                        <option value="vice-president">Vice-Président</option>
                        <option value="president">Président</option>
                        <option value="secretaire">Secrétaire</option>
                        <option value="tresorier">Trésorier</option>
                    </select>
                </td>
            </tr>
            <tr>
                <td></td>
                <td>
                    <br />
                    <a href="#" onclick="ajouterMembre(); return false;">Confirmer l'ajout</a>
                    &nbsp;|&nbsp;
                    <a href="#" onclick="showAddMembreForm(); return false;">Annuler</a>
                </td>
            </tr>
        </table>

        <br />
    </div>

    <!-- Tableau des membres -->
    <table border="1" cellpadding="10" style="border-collapse: collapse;">
        <tr>
            <th>Utilisateur</th>
            <th>Rôle</th>
            <th>Date d'adhésion</th>
            <th>Actions</th>
        </tr>
        <tbody id="membresTableBody">
            <tr>
                <td colspan="4">Sélectionnez un club pour voir ses membres</td>
            </tr>
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        let currentClubId = null;

        function showMembres(clubId, clubNom) {
            currentClubId = clubId;
            document.getElementById('clubNom').innerText = clubNom;
            document.getElementById('clubIdForMembre').value = clubId;
            document.getElementById('membresSection').style.display = 'block';
            chargerMembres(clubId);
            document.getElementById('membresSection').scrollIntoView({ behavior: 'smooth' });
        }

        function hideMembres() {
            document.getElementById('membresSection').style.display = 'none';
            currentClubId = null;
        }

        function showAddMembreForm() {
            const form = document.getElementById('addMembreForm');
            form.style.display = form.style.display === 'none' ? 'block' : 'none';
        }

        async function chargerMembres(clubId) {
            try {
                const response = await fetch(`/MembresClubs/GetMembresByClubJson?clubId=${clubId}`);
                const membres = await response.json();
                const tbody = document.getElementById('membresTableBody');

                if (membres.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="4">Aucun membre dans ce club</td></tr>';
                    return;
                }

                let html = '';
                for (const m of membres) {
                    html += `
                        <tr>
                            <td>${m.email}</td>
                            <td>${m.roleMembre}</td>
                            <td>${new Date(m.dateAdhesion).toLocaleDateString('fr-FR')}</td>
                            <td>
                                <a href="#" onclick="modifierRole(${m.idUtilisateur}, ${m.idClub}, '${m.roleMembre}'); return false;">Modifier</a>
                                |
                                <a href="#" onclick="supprimerMembre(${m.idUtilisateur}, ${m.idClub}); return false;">Supprimer</a>
                            </td>
                        </tr>
                    `;
                }
                tbody.innerHTML = html;
            } catch (error) {
                console.error('Erreur:', error);
            }
        }

        async function ajouterMembre() {
            const utilisateurId = document.getElementById('utilisateurId').value;
            const roleMembre = document.getElementById('roleMembre').value;

            if (!utilisateurId) {
                alert('Veuillez sélectionner un utilisateur');
                return;
            }

            try {
                const response = await fetch('/MembresClubs/AjouterMembre', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        IdUtilisateur: parseInt(utilisateurId),
                        IdClub: currentClubId,
                        RoleMembre: roleMembre
                    })
                });

                if (response.ok) {
                    alert('Membre ajouté avec succès !');
                    document.getElementById('addMembreForm').style.display = 'none';
                    document.getElementById('utilisateurId').value = '';
                    chargerMembres(currentClubId);
                } else {
                    const error = await response.text();
                    alert('Erreur : ' + error);
                }
            } catch (error) {
                console.error('Erreur:', error);
                alert("Erreur lors de l'ajout");
            }
        }

        async function modifierRole(idUtilisateur, idClub, roleActuel) {
            const nouveauRole = prompt('Entrez le nouveau rôle (membre, vice-president, president, secretaire, tresorier):', roleActuel);
            if (nouveauRole && nouveauRole !== roleActuel) {
                try {
                    const response = await fetch('/MembresClubs/ModifierRole', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            IdUtilisateur: idUtilisateur,
                            IdClub: idClub,
                            RoleMembre: nouveauRole
                        })
                    });

                    if (response.ok) {
                        alert('Rôle modifié avec succès !');
                        chargerMembres(currentClubId);
                    } else {
                        alert('Erreur lors de la modification');
                    }
                } catch (error) {
                    console.error('Erreur:', error);
                }
            }
        }

        async function supprimerMembre(idUtilisateur, idClub) {
            if (confirm('Voulez-vous vraiment retirer ce membre du club ?')) {
                try {
                    const response = await fetch(`/MembresClubs/SupprimerMembre?idUtilisateur=${idUtilisateur}&idClub=${idClub}`, {
                        method: 'DELETE'
                    });

                    if (response.ok) {
                        alert('Membre retiré avec succès !');
                        chargerMembres(currentClubId);
                    } else {
                        alert('Erreur lors de la suppression');
                    }
                } catch (error) {
                    console.error('Erreur:', error);
                }
            }
        }
    </script>
}