@model IEnumerable<GESTION_S_E.Controllers.ClubsController.ClubWithResponsableName>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Gestion des Clubs";
}

<h1>Liste des Clubs</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">Créer un nouveau club</a>
</p>

<div class="table-responsive">
    <table class="table table-striped table-bordered align-middle">
        <thead class="table-light">
            <tr>
                <th>Nom du Club</th>
                <th>Description</th>
                <th>Responsable</th>
                <th>Date Création</th>
                <th>Statut</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.NomClub</td>
                    <td>@(item.Description?.Length > 50 ? item.Description.Substring(0, 50) + "..." : item.Description)</td>
                    <td>@item.ResponsableNomComplet</td>
                    <td>@item.DateCreation.ToString("dd/MM/yyyy")</td>
                    <td>@(item.Actif ? "Actif" : "Inactif")</td>
                    <td class="text-end">
                        <div class="table-actions d-inline-flex gap-1">
                            <a asp-action="Members" asp-route-id="@item.IdClub" class="btn btn-sm btn-outline-primary">Membres</a>
                            <a asp-action="Edit" asp-route-id="@item.IdClub" class="btn btn-sm btn-outline-secondary">Modifier</a>
                            <a asp-action="Delete" asp-route-id="@item.IdClub" class="btn btn-sm btn-outline-danger">Supprimer</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>