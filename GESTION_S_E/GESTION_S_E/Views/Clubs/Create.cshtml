@model GESTION_S_E.Models.Club
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Nouveau Club";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6 border p-4 shadow-sm bg-light">
            <h4 class="mb-3">Nouveau Club</h4>
            
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <ul>
                        @foreach (var modelError in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@modelError.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }
            
            <form asp-action="Create" method="post">
                <div class="form-group mb-3">
                    <label asp-for="NomClub" class="control-label">Nom du Club</label>
                    <input asp-for="NomClub" class="form-control" placeholder="Ex: Club Informatique" />
                    <span asp-validation-for="NomClub" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Description" class="control-label">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="IdResponsable" class="control-label">Responsable</label>
                    <select asp-for="IdResponsable" class="form-control" asp-items="ViewBag.IdResponsable">
                        <option value="">-- Sélectionner un responsable (Email) --</option>
                    </select>
                    <span asp-validation-for="IdResponsable" class="text-danger"></span>
                </div>

                <div class="form-group mt-4">
                    <button type="submit" class="btn btn-success w-100">Enregistrer</button>
                    <a asp-action="Index" class="btn btn-link w-100 mt-2 text-secondary">Annuler</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}