@model GESTION_S_E.Models.Club
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Nouveau Club";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6 border p-4 shadow-sm bg-light">
            <h4 class="mb-3"><i class="fas fa-users"></i> Nouveau Club</h4>

            <form asp-action="Create" method="post">
                <div class="form-group mb-3">
                    <label asp-for="NomClub" class="control-label">Nom du Club</label>
                    <input asp-for="NomClub" class="form-control" placeholder="Ex: Club Informatique" required />
                    <span asp-validation-for="NomClub" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Description" class="control-label">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Décrivez les activités du club..."></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="IdResponsable" class="control-label">Responsable du Club</label>
                    <select asp-for="IdResponsable" class="form-control" asp-items="ViewBag.IdResponsable" required>
                        <option value="">-- Sélectionner un responsable --</option>
                    </select>
                    <span asp-validation-for="IdResponsable" class="text-danger"></span>
                </div>

                <div class="form-group mt-4">
                    <button type="submit" class="btn btn-success w-100">Enregistrer</button>
                    <a asp-action="Index" class="btn btn-link w-100 mt-2 text-secondary">Annuler</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}