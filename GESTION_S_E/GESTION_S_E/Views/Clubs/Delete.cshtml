@model GESTION_S_E.Models.Club
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Supprimer un club";
}

<h1>🗑️ Supprimer @Model.NomClub</h1>

<div class="alert alert-danger">
    ⚠️ Cette action est irréversible.
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Nom</dt>
            <dd class="col-sm-9">@Model.NomClub</dd>

            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">@Model.Description</dd>

            <dt class="col-sm-3">Responsable</dt>
            <dd class="col-sm-9">
                @if (Model.Responsable != null)
                {
                    @Model.Responsable.Email
                }
                else
                {
                    <span class="text-muted">Aucun responsable</span>
                }
            </dd>

            <dt class="col-sm-3">Date création</dt>
            <dd class="col-sm-9">@Model.DateCreation.ToString("dd/MM/yyyy")</dd>

            <dt class="col-sm-3">Statut</dt>
            <dd class="col-sm-9">@(Model.Actif ? "Actif" : "Inactif")</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="IdClub" />
    <button type="submit" class="btn btn-danger">Confirmer la suppression</button>
    <a asp-action="Index" class="btn btn-secondary">Annuler</a>
</form>