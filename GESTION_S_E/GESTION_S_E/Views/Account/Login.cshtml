@{
    Layout = null;
    ViewData["Title"] = "Connexion - Gestion Salles EMIT";
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        body {
            background-color: #ffffff;
            font-family: 'DM Sans', sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .login-wrapper {
            width: 100%;
            max-width: 380px;
            padding: 20px;
        }
        .form-control {
            padding: 10px 12px;
            border-radius: 6px;
            border: 1px solid #e2e8f0;
            background-color: #f8fafc;
            font-size: 14px;
        }
        .form-control:focus {
            border-color: #0f172a;
            background-color: #fff;
            box-shadow: none;
        }
        .btn-dark {
            background-color: #0f172a;
            border: none;
            padding: 11px;
            border-radius: 6px;
            font-size: 14px;
            font-weight: 500;
        }
        .btn-dark:hover { background-color: #1e293b; }
        .test-accounts {
            background: #f8fafc;
            border-radius: 6px;
            font-size: 12px;
        }
    </style>
</head>
<body>

    <div class="login-wrapper">
        <div class="text-center mb-4">
            <div class="text-dark mb-2" style="font-size: 28px;"><i class="fas fa-chalkboard-user"></i></div>
            <h1 class="h5 fw-semibold text-dark m-0">Gestion des Salles & EDT</h1>
            <p class="text-muted small m-0">École Management et Innovation Technologique</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger py-2 px-3 small border-0 rounded-2">
                <i class="fas fa-exclamation-circle me-1"></i> @ViewBag.Error
            </div>
        }

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success py-2 px-3 small border-0 rounded-2">
                <i class="fas fa-check-circle me-1"></i> @TempData["Success"]
            </div>
        }

        <form method="post" action="/Account/Login">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label text-secondary small fw-medium" for="email">Adresse email</label>
                <input type="email" id="email" class="form-control" name="email" placeholder="vous@emit.mg" required autofocus>
            </div>

            <div class="mb-3">
                <label class="form-label text-secondary small fw-medium" for="password">Mot de passe</label>
                <input type="password" id="password" class="form-control" name="password" placeholder="••••••••" required>
            </div>

            <div class="form-check mb-4 small">
                <input type="checkbox" class="form-check-input" id="rememberMe" name="rememberMe" style="accent-color: #0f172a;">
                <label class="form-check-label text-muted" for="rememberMe">Se souvenir de moi</label>
            </div>

            <button type="submit" class="btn btn-dark w-100">
                Se connecter <i class="fas fa-arrow-right small ms-1"></i>
            </button>
        </form>

        <div class="text-center small mt-3">
            <span class="text-muted">Pas encore de compte ?</span> <a href="/Account/Register" class="text-dark fw-medium text-decoration-none hover-underline">S'inscrire</a>
        </div>

        <div class="test-accounts p-3 mt-4 border text-secondary">
            <div class="fw-semibold text-uppercase text-muted mb-2" style="font-size: 10px; letter-spacing: 0.5px;">
                <i class="fas fa-info-circle"></i> Comptes de test
            </div>
            <div class="d-flex justify-content-between py-1"><span>Admin</span> <span class="text-dark">admin@emit.mg</span></div>
            <div class="d-flex justify-content-between py-1"><span>Enseignant</span> <span class="text-dark">enseignant@emit.mg</span></div>
            <div class="d-flex justify-content-between py-1"><span>Élève</span> <span class="text-dark">eleve@emit.mg</span></div>
        </div>

        <div class="text-center text-muted mt-4" style="font-size: 11px;">
            &copy; @DateTime.Now.Year EMIT — Tous droits réservés
        </div>
    </div>

</body>
</html>