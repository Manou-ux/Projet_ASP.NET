@model GESTION_S_E.Models.ResetPasswordViewModel
@{
    ViewData["Title"] = "Réinitialisation du mot de passe";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <div class="container d-flex justify-content-center align-items-center min-vh-100">
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h2 class="text-center mb-4">Réinitialisation du mot de passe</h2>

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger">@TempData["Error"]</div>
                    }
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success">@TempData["Success"]</div>
                    }

                    <form method="post" action="/Account/ResetPassword">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="Token" value="@Model.Token" />

                        <div class="mb-3">
                            <label class="form-label">Nouveau mot de passe</label>
                            <input type="password" name="NewPassword" class="form-control" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Confirmer le mot de passe</label>
                            <input type="password" name="ConfirmPassword" class="form-control" required />
                        </div>

                        <button type="submit" class="btn btn-primary w-100">Réinitialiser</button>
                    </form>

                    <div class="text-center mt-3">
                        <a href="/Account/Login" class="text-decoration-none">Retour à la connexion</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>