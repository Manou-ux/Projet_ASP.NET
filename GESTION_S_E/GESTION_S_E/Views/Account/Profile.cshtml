@{
    ViewData["Title"] = "Mon profil";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h4><i class="fas fa-id-card"></i> Mon profil</h4>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="fw-bold">Email :</label>
                        <p>@ViewBag.Email</p>
                    </div>
                    <div class="mb-3">
                        <label class="fw-bold">Rôle :</label>
                        <p>@ViewBag.Role</p>
                    </div>
                    <div class="mb-3">
                        <label class="fw-bold">Date d'inscription :</label>
                        <p>@ViewBag.DateCreation.ToString("dd/MM/yyyy HH:mm")</p>
                    </div>
                    <hr />
                    <a href="/Account/Logout" class="btn btn-danger">
                        <i class="fas fa-sign-out-alt"></i> Se déconnecter
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>