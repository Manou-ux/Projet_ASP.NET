@{
    Layout = null;
    ViewData["Title"] = "Inscription - Gestion Salles EMIT";
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
            body {
                background-color: #ffffff;
                font-family: 'DM Sans', sans-serif;
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 40px 20px;
            }

            .register-wrapper {
                width: 100%;
                max-width: 440px;
            }

            .form-control, .form-select {
                padding: 10px 12px;
                border-radius: 6px;
                border: 1px solid #e2e8f0;
                background-color: #f8fafc;
                font-size: 14px;
            }

                .form-control:focus, .form-select:focus {
                    border-color: #0f172a;
                    background-color: #fff;
                    box-shadow: none;
                }

            .btn-dark {
                background-color: #0f172a;
                border: none;
                padding: 11px;
                border-radius: 6px;
                font-size: 14px;
                font-weight: 500;
            }

                .btn-dark:hover {
                    background-color: #1e293b;
                }

            .section-title {
                font-size: 11px;
                font-weight: 600;
                color: #94a3b8;
                text-transform: uppercase;
                letter-spacing: 0.5px;
                margin-bottom: 12px;
            }
    </style>
</head>
<body>

    <div class="register-wrapper">
        <div class="text-center mb-4">
            <div class="text-dark mb-2" style="font-size: 28px;"><i class="fas fa-user-plus"></i></div>
            <h1 class="h5 fw-semibold text-dark m-0">Créer un compte</h1>
            <p class="text-muted small m-0">École de Management et d'Innovation Technologique</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger py-2 px-3 small border-0 rounded-2 mb-3">
                <i class="fas fa-exclamation-circle me-1"></i> @ViewBag.Error
            </div>
        }

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success py-2 px-3 small border-0 rounded-2 mb-3">
                <i class="fas fa-check-circle me-1"></i> @TempData["Success"]
            </div>
        }

        <form method="post" action="/Account/Register" id="registerForm">
            @Html.AntiForgeryToken()

            <div class="section-title">Identité</div>

            <div class="row g-2 mb-2">
                <div class="col">
                    <input type="text" class="form-control" name="nom" placeholder="Nom" required
                           pattern="[A-Za-zÀ-ÿ\s-]+" />
                </div>
                <div class="col">
                    <input type="text" class="form-control" name="prenom" placeholder="Prénom" required
                           pattern="[A-Za-zÀ-ÿ\s-]+" />
                </div>
            </div>

            <div class="mb-2">
                <input type="email" class="form-control" name="email" placeholder="Adresse email" required />
            </div>

            <div class="mb-4">
                <input type="text" class="form-control" name="telephone" placeholder="Téléphone (optionnel)"
                       pattern="[0-9]*" />
            </div>

            <div class="section-title">Rôle professionnel</div>

            <div class="mb-3">
                <select class="form-select" name="role" id="RoleSelect" required>
                    <option value="">Choisir un rôle…</option>
                    <option value="eleve">Élève</option>
                    <option value="enseignant">Enseignant</option>
                    <option value="scolarite">Scolarité</option>
                </select>
            </div>

            <div id="EleveFields" class="mb-3" style="display: none;">
                <div class="mb-2">
                    <input type="text" class="form-control" name="matricule" placeholder="Matricule ..." />
                </div>
                <div>
                    <select class="form-select" name="idClasse">
                        <option value="">Sélectionner une classe</option>
                        @foreach (var classe in ViewBag.Classes)
                        {
                            <option value="@classe.Value">@classe.Text</option>
                        }
                    </select>
                </div>
            </div>

            <div id="EnseignantFields" class="mb-3" style="display: none;">
                <input type="text" class="form-control" name="specialite" placeholder="Spécialité" />
            </div>

            <div id="ScolariteFields" class="mb-3" style="display: none;">
                <div class="row g-2">
                    <div class="col">
                        <input type="text" class="form-control" name="fonction" placeholder="Fonction" />
                    </div>
                    <div class="col">
                        <input type="text" class="form-control" name="bureau" placeholder="Bureau" />
                    </div>
                </div>
            </div>

            <div class="section-title mt-4">Sécurité</div>

            <div class="mb-2">
                <input type="password" class="form-control" name="password" id="password"
                       placeholder="Mot de passe (6 caractères)" required
                       minlength="6" maxlength="6" pattern=".{6}" />
            </div>

            <div class="mb-4">
                <input type="password" class="form-control" name="confirmPassword"
                       placeholder="Confirmer le mot de passe" required
                       minlength="6" maxlength="6" pattern=".{6}" />
            </div>

            <button type="submit" class="btn btn-dark w-100">
                Créer mon compte <i class="fas fa-check small ms-1"></i>
            </button>
        </form>

        <div class="text-center small mt-3">
            <span class="text-muted">Déjà inscrit ?</span> <a href="@Url.Action("Login", "Account")" class="text-dark fw-medium text-decoration-none hover-underline">Se connecter</a>
        </div>

        <div class="text-center text-muted mt-5" style="font-size: 11px;">
            &copy; @DateTime.Now.Year EMIT — Tous droits réservés
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Gestion des champs spécifiques au rôle
        const roleSelect = document.getElementById('RoleSelect');
        const sections = {
        eleve: document.getElementById('EleveFields'),
        enseignant: document.getElementById('EnseignantFields'),
        scolarite: document.getElementById('ScolariteFields')
        };

        function toggleFields() {
        Object.values(sections).forEach(el => el.style.display = 'none');
        const selected = roleSelect.value;
        if (sections[selected]) {
        sections[selected].style.display = 'block';
        }
        }

        roleSelect.addEventListener('change', toggleFields);

        // --- Contraintes de saisie en direct ---

        // 1. Nom et prénom : ne laisser que des lettres, espaces et tirets
        document.querySelector('input[name="nom"]').addEventListener('input', function(e) {
        this.value = this.value.replace(/[^A-Za-zÀ-ÿ\s-]/g, '');
        });
        document.querySelector('input[name="prenom"]').addEventListener('input', function(e) {
        this.value = this.value.replace(/[^A-Za-zÀ-ÿ\s-]/g, '');
        });

        // 2. Téléphone : ne laisser que des chiffres
        document.querySelector('input[name="telephone"]').addEventListener('input', function(e) {
        this.value = this.value.replace(/\D/g, '');
        });

        // 3. Mot de passe : limiter à 6 caractères (coupe au-delà)
        document.getElementById('password').addEventListener('input', function(e) {
        if (this.value.length > 6) {
        this.value = this.value.slice(0, 6);
        }
        });

        document.querySelector('input[name="confirmPassword"]').addEventListener('input', function(e) {
        if (this.value.length > 6) {
        this.value = this.value.slice(0, 6);
        }
        });
    </script>
</body>
</html>