@model List<GESTION_S_E.Models.Matiere>

<h1>Liste des matières</h1>

@if (TempData["Success"] != null)
{
    <div style="background-color: green; color: white; padding: 15px; margin-bottom: 20px; border-radius: 5px;">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div style="background-color: red; color: white; padding: 15px; margin-bottom: 20px; border-radius: 5px;">
        @TempData["Error"]
    </div>
}

<p>
    <a class="btn btn-primary" href="/Matieres/Create">Ajouter une matière</a>
</p>

@if (Model != null && Model.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Code</th>
                    <th>Nom de la matière</th>
                    <th>Volume horaire</th>
                    <th>Coefficient</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var matiere in Model)
                {
                    <tr>
                        <td>@matiere.IdMatiere</td>
                        <td>@matiere.CodeMatiere</td>
                        <td>@matiere.NomMatiere</td>
                        <td>@(matiere.VolumeHoraire?.ToString() ?? "-")</td>
                        <td>@matiere.Coefficient.ToString("0.00")</td>
                        <td class="text-end">
                            <div class="table-actions d-inline-flex gap-1">
                                <a class="btn btn-sm btn-outline-secondary" href="/Matieres/Edit/@matiere.IdMatiere">Modifier</a>
                                <a class="btn btn-sm btn-outline-danger" href="/Matieres/Delete/@matiere.IdMatiere">Supprimer</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <p>Aucune matière trouvée. Cliquez sur "Ajouter une matière" pour créer la première matière.</p>
}