@model List<GESTION_S_E.Models.Salle>

<h1>Liste des salles</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

<p>
    <a class="btn btn-primary" href="/Salles/Create">Ajouter une salle</a>
</p>

<div class="table-responsive">
    <table class="table table-striped table-bordered align-middle">
        <thead class="table-light">
            <tr>
                <th>ID</th>
                <th>Nom</th>
                <th>Capacité</th>
                <th>Type</th>
                <th>Localisation</th>
                <th>Disponible</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var salle in Model)
            {
                <tr>
                    <td>@salle.IdSalle</td>
                    <td>@salle.NomSalle</td>
                    <td>@salle.Capacite</td>
                    <td>@salle.Type</td>
                    <td>@salle.Localisation</td>
                    <td>@salle.Disponible</td>
                    <td class="text-end">
                        <div class="table-actions d-inline-flex gap-1">
                            
                            <a class="btn btn-sm btn-outline-secondary" href="/Salles/Edit/@salle.IdSalle">Modifier</a>
                            <a class="btn btn-sm btn-outline-danger" href="/Salles/Delete/@salle.IdSalle">Supprimer</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
