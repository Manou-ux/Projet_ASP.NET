@model IEnumerable<GESTION_S_E.Models.ReservationSalle>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Calendrier des réservations";
    
    // Récupérer la date de début de semaine depuis ViewBag ou utiliser la date actuelle
    var startOfWeek = ViewBag.StartOfWeek != null ? (DateTime)ViewBag.StartOfWeek : GetStartOfWeek(DateTime.Today);
    var endOfWeek = startOfWeek.AddDays(6);
}

@functions {
    public DateTime GetStartOfWeek(DateTime date)
    {
        // Commencer la semaine le lundi
        int diff = (7 + (date.DayOfWeek - DayOfWeek.Monday)) % 7;
        return date.AddDays(-diff).Date;
    }
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Calendrier des réservations</h2>
        <div>
            <a asp-action="Create" class="btn btn-primary">
                <i class="fas fa-plus"></i> Nouvelle réservation
            </a>
            <a asp-action="Index" class="btn btn-secondary ms-2">
                <i class="fas fa-list"></i> Vue liste
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="fas fa-calendar-alt"></i> Calendrier hebdomadaire</h5>
                <div>
                    <a asp-action="Calendar" asp-route-weekOffset="-1" class="btn btn-sm btn-light">
                        <i class="fas fa-chevron-left"></i> Semaine précédente
                    </a>
                    <a asp-action="Calendar" asp-route-weekOffset="0" class="btn btn-sm btn-light">
                        <i class="fas fa-calendar-week"></i> Cette semaine
                    </a>
                    <a asp-action="Calendar" asp-route-weekOffset="1" class="btn btn-sm btn-light">
                        Semaine suivante <i class="fas fa-chevron-right"></i>
                    </a>
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col text-center">
                    <h6>Semaine du @startOfWeek.ToString("dd/MM/yyyy") au @endOfWeek.ToString("dd/MM/yyyy")</h6>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-bordered text-center">
                    <thead class="table-dark">
                        <tr>
                            <th style="width: 14%;">Lundi<br />@startOfWeek.ToString("dd/MM")</th>
                            <th style="width: 14%;">Mardi<br />@startOfWeek.AddDays(1).ToString("dd/MM")</th>
                            <th style="width: 14%;">Mercredi<br />@startOfWeek.AddDays(2).ToString("dd/MM")</th>
                            <th style="width: 14%;">Jeudi<br />@startOfWeek.AddDays(3).ToString("dd/MM")</th>
                            <th style="width: 14%;">Vendredi<br />@startOfWeek.AddDays(4).ToString("dd/MM")</th>
                            <th style="width: 14%;">Samedi<br />@startOfWeek.AddDays(5).ToString("dd/MM")</th>
                            <th style="width: 14%;">Dimanche<br />@startOfWeek.AddDays(6).ToString("dd/MM")</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            @for (int i = 0; i < 7; i++)
                            {
                                var currentDay = startOfWeek.AddDays(i);
                                var dayReservations = Model.Where(r => r.DateReservation.Date == currentDay && r.Statut != "annulee").ToList();
                                
                                <td style="vertical-align: top; height: 400px; background-color: @(currentDay.Date == DateTime.Today ? "#fff3cd" : "white")">
                                    <div style="overflow-y: auto; max-height: 380px;">
                                        @if (currentDay < DateTime.Today)
                                        {
                                            <div class="text-muted small">(Passé)</div>
                                        }
                                        @foreach (var res in dayReservations)
                                        {
                                            var demandeurNom = res.Utilisateur?.Enseignant != null 
                                                ? $"{res.Utilisateur.Enseignant.PrenomEnseignant} {res.Utilisateur.Enseignant.NomEnseignant}"
                                                : res.Utilisateur?.Email ?? "Inconnu";
                                                
                                            <div class="card mb-2 @(res.Statut == "validee" ? "border-success" : "border-warning")" style="font-size: 12px; text-align: left;">
                                                <div class="card-body p-2">
                                                    <strong>@res.HeureDebut.ToString(@"hh\:mm") - @res.HeureFin.ToString(@"hh\:mm")</strong>
                                                    <hr class="my-1" />
                                                    <div><i class="fas fa-door-open"></i> @res.Salle?.NomSalle</div>
                                                    <div><i class="fas fa-user"></i> @demandeurNom</div>
                                                    <div class="text-truncate" title="@res.Motif">
                                                        <i class="fas fa-comment"></i> @res.Motif
                                                    </div>
                                                    <div class="mt-1">
                                                        <span class="badge @(res.Statut == "validee" ? "bg-success" : "bg-warning")">
                                                            @(res.Statut == "validee" ? "Validée" : "En attente")
                                                        </span>
                                                    </div>
                                                    <div class="mt-1">
                                                        <a asp-action="Details" asp-route-id="@res.IdReservation" class="btn btn-sm btn-outline-info w-100">
                                                            <i class="fas fa-info-circle"></i> Détails
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </td>
                            }
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>