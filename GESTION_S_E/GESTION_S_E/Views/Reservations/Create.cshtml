@model GESTION_S_E.Models.ReservationSalle

@{
    ViewData["Title"] = "Ajouter une réservation";
}

<h1>Ajouter une réservation</h1>

<form method="post">
    @Html.AntiForgeryToken()

    <div>
        <label>Salle *</label><br />
        <select name="IdSalle" required style="width: 300px;">
            <option value="">-- Choisir une salle --</option>
            @if (ViewBag.Salles != null)
            {
                foreach (var salle in ViewBag.Salles)
                {
                    <option value="@salle.IdSalle">@salle.NomSalle (Capacité: @salle.Capacite, Type: @salle.Type)</option>
                }
            }
        </select>
    </div>
    <br />

    <div>
        <label>Utilisateur (demandeur) *</label><br />
        <select name="IdUtilisateur" required style="width: 300px;">
            <option value="">-- Choisir un utilisateur --</option>
            @if (ViewBag.Utilisateurs != null)
            {
                foreach (var user in ViewBag.Utilisateurs)
                {
                    <option value="@user.IdUtilisateur">@user.Email (@user.Role)</option>
                }
            }
        </select>
    </div>
    <br />

    <div>
        <label>Club (optionnel)</label><br />
        <select name="IdClub" style="width: 300px;">
            <option value="">-- Aucun club --</option>
            @if (ViewBag.Clubs != null)
            {
                foreach (var club in ViewBag.Clubs)
                {
                    <option value="@club.IdClub">@club.NomClub</option>
                }
            }
        </select>
    </div>
    <br />

    <div>
        <label>Date *</label><br />
        <input type="date" name="DateReservation" required style="width: 200px;" />
    </div>
    <br />

    <div>
        <label>Heure début *</label><br />
        <input type="time" name="HeureDebut" required style="width: 150px;" />
    </div>
    <br />

    <div>
        <label>Heure fin *</label><br />
        <input type="time" name="HeureFin" required style="width: 150px;" />
    </div>
    <br />

    <div>
        <label>Motif *</label><br />
        <textarea name="Motif" rows="3" style="width: 300px;" required></textarea>
    </div>
    <br />

    <button type="submit">Enregistrer</button>
    <a href="/Reservations/Index">Annuler</a>
</form>