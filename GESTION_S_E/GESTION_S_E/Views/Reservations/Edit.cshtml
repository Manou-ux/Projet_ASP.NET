@model GESTION_S_E.Models.ReservationSalle
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Modifier une réservation";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6 border p-4 shadow-sm bg-light">
            <h4 class="mb-3">Modifier la réservation</h4>
            
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <ul>
                        @foreach (var modelError in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@modelError.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }
            
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="IdReservation" />
                <input type="hidden" asp-for="DateReservation" />
                
                <div class="form-group mb-3">
                    <label asp-for="IdSalle" class="control-label">Salle</label>
                    <select asp-for="IdSalle" class="form-control" asp-items="ViewBag.Salles">
                        <option value="">-- Sélectionner une salle --</option>
                    </select>
                    <span asp-validation-for="IdSalle" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="IdUtilisateur" class="control-label">Demandeur (Utilisateur)</label>
                    <select asp-for="IdUtilisateur" class="form-control" asp-items="ViewBag.Utilisateurs">
                        <option value="">-- Sélectionner un utilisateur --</option>
                    </select>
                    <span asp-validation-for="IdUtilisateur" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="IdClub" class="control-label">Club (optionnel)</label>
                    <select asp-for="IdClub" class="form-control" asp-items="ViewBag.Clubs">
                        <option value="">-- Aucun club --</option>
                    </select>
                    <span asp-validation-for="IdClub" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label asp-for="HeureDebut" class="control-label">Heure début</label>
                            <input asp-for="HeureDebut" class="form-control" type="time" />
                            <span asp-validation-for="HeureDebut" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label asp-for="HeureFin" class="control-label">Heure fin</label>
                            <input asp-for="HeureFin" class="form-control" type="time" />
                            <span asp-validation-for="HeureFin" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Motif" class="control-label">Motif</label>
                    <textarea asp-for="Motif" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Motif" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Statut" class="control-label">Statut</label>
                    <select asp-for="Statut" class="form-control">
                        <option value="en_attente">⏳ En attente</option>
                        <option value="validee">✅ Validée</option>
                        <option value="annulee">❌ Annulée</option>
                    </select>
                    <span asp-validation-for="Statut" class="text-danger"></span>
                </div>

                <div class="form-group mt-4">
                    <button type="submit" class="btn btn-primary w-100">Modifier</button>
                    <a asp-action="Index" class="btn btn-link w-100 mt-2 text-secondary">Annuler</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}