@model GESTION_S_E.Models.ReservationSalle
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Supprimer une réservation";
    
    var demandeurNom = Model.Utilisateur?.Enseignant != null 
        ? $"{Model.Utilisateur.Enseignant.PrenomEnseignant} {Model.Utilisateur.Enseignant.NomEnseignant}"
        : Model.Utilisateur?.Email ?? "Inconnu";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-danger">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0"><i class="fas fa-exclamation-triangle"></i> Confirmation de suppression</h5>
                </div>
                <div class="card-body">
                    <h5 class="card-title text-danger">Êtes-vous sûr de vouloir supprimer cette réservation ?</h5>
                    
                    <div class="alert alert-warning">
                        <p class="mb-0">Cette action est irréversible.</p>
                    </div>

                    <div class="table-responsive mt-3">
                        <table class="table table-bordered">
                            <tr>
                                <th style="width: 40%;">ID</th>
                                <td>@Model.IdReservation</td>
                            </tr>
                            <tr>
                                <th>Date</th>
                                <td>@Model.DateReservation.ToString("dd/MM/yyyy")</td>
                            </tr>
                            <tr>
                                <th>Horaire</th>
                                <td>@Model.HeureDebut.ToString(@"hh\:mm") - @Model.HeureFin.ToString(@"hh\:mm")</td>
                            </tr>
                            <tr>
                                <th>Salle</th>
                                <td>@Model.Salle?.NomSalle</td>
                            </tr>
                            <tr>
                                <th>Demandeur</th>
                                <td>@demandeurNom</td>
                            </tr>
                            <tr>
                                <th>Club</th>
                                <td>@(Model.Club?.NomClub ?? "Aucun")</td>
                            </tr>
                            <tr>
                                <th>Motif</th>
                                <td>@Model.Motif</td>
                            </tr>
                            <tr>
                                <th>Statut</th>
                                <td>
                                    <span class="badge @(Model.Statut == "validee" ? "bg-success" : Model.Statut == "en_attente" ? "bg-warning" : "bg-danger")">
                                        @(Model.Statut == "validee" ? "✅ Validée" : Model.Statut == "en_attente" ? "⏳ En attente" : "❌ Annulée")
                                    </span>
                                 </td>
                            </tr>
                        </table>
                    </div>

                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="IdReservation" />
                        <div class="d-flex gap-2 mt-3">
                            <button type="submit" class="btn btn-danger flex-grow-1">
                                <i class="fas fa-trash"></i> Confirmer la suppression
                            </button>
                            <a asp-action="Index" class="btn btn-secondary flex-grow-1">
                                <i class="fas fa-times"></i> Annuler
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>