@model IEnumerable<GESTION_S_E.Models.ReservationSalle>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Gestion des Réservations";
    bool isEnseignant = User.Identity.IsAuthenticated && User.IsInRole("enseignant");
}

<div class="page-header">
    <div>
        <h1>Liste des réservations</h1>
        <p class="text-muted">Toutes les réservations de salles et événements.</p>
    </div>
    <div class="form-actions">
        <a class="btn btn-primary" href="/Reservations/Create"><i class="fas fa-plus me-1"></i> Nouvelle réservation</a>
        <a class="btn btn-outline-secondary" href="/Reservations/Calendar"><i class="fas fa-calendar-alt me-1"></i> Vue calendrier</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success" role="alert">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger" role="alert">
        @TempData["Error"]
    </div>
}

<div class="table-responsive">
    <table class="table table-striped table-bordered align-middle">
        <thead class="table-light">
            <tr>
                <th>ID</th>
                <th>Date</th>
                <th>Horaire</th>
                <th>Salle</th>
                <th>Demandeur</th>
                <th>Club</th>
                <th>Motif</th>
                <th>Statut</th>
                <th>Actions</th>
                @if (!isEnseignant)
                {
                    <th>État</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                var demandeurNom = item.Utilisateur?.Enseignant != null
                    ? $"{item.Utilisateur.Enseignant.PrenomEnseignant} {item.Utilisateur.Enseignant.NomEnseignant}"
                    : item.Utilisateur?.Email ?? "Inconnu";

                <tr>
                    <td>@item.IdReservation</td>
                    <td>@item.DateReservation.ToString("dd/MM/yyyy")</td>
                    <td>@item.HeureDebut.ToString(@"hh\:mm") - @item.HeureFin.ToString(@"hh\:mm")</td>
                    <td>@item.Salle?.NomSalle</td>
                    <td>@demandeurNom</td>
                    <td>@(item.Club?.NomClub ?? "-")</td>
                    <td>@(item.Motif?.Length > 35 ? item.Motif.Substring(0, 35) + "..." : item.Motif)</td>
                    <td>
                        <span class="badge rounded-pill @(item.Statut == "validee" ? "bg-success" : item.Statut == "en_attente" ? "bg-warning text-dark" : "bg-danger")">
                            @(item.Statut == "validee" ? "Validée" : item.Statut == "en_attente" ? "En attente" : "Annulée")
                        </span>
                    </td>
                    <td class="text-end">
                        <div class="reservation-primary-actions d-inline-flex gap-1">
                            <a class="btn btn-sm btn-outline-secondary" href="/Reservations/Edit/@item.IdReservation">Modifier</a>
                            <a class="btn btn-sm btn-outline-danger" href="/Reservations/Delete/@item.IdReservation">Supprimer</a>
                        </div>
                    </td>
                    @if (!isEnseignant)
                    {
                        <td class="text-end">
                            @if (User.Identity.IsAuthenticated && User.IsInRole("scolarite"))
                            {
                                <div class="reservation-status-actions d-inline-flex gap-1 justify-content-end">
                                    @if (item.Statut == "en_attente")
                                    {
                                        <form asp-action="Valider" asp-route-id="@item.IdReservation" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-success">Valider</button>
                                        </form>
                                    }
                                    @if (item.Statut != "annulee")
                                    {
                                        <form asp-action="Annuler" asp-route-id="@item.IdReservation" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-secondary">Annuler</button>
                                        </form>
                                    }
                                </div>
                            }
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>