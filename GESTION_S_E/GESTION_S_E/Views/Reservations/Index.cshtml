@model IEnumerable<GESTION_S_E.Models.ReservationSalle>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Gestion des Réservations";
}

<h1>Liste des Réservations</h1>

@if (TempData["Success"] != null)
{
    <div style="background-color: green; color: white; padding: 15px; margin-bottom: 20px; border-radius: 5px;">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div style="background-color: red; color: white; padding: 15px; margin-bottom: 20px; border-radius: 5px;">
        @TempData["Error"]
    </div>
}

<a href="/Reservations/Create">Nouvelle réservation</a>
&nbsp;|&nbsp;
<a href="/Reservations/Calendar">Vue calendrier</a>

<br /><br />

<table border="1" cellpadding="10" style="border-collapse: collapse;">
    <tr>
        <th>ID</th>
        <th>Date</th>
        <th>Horaire</th>
        <th>Salle</th>
        <th>Demandeur</th>
        <th>Club</th>
        <th>Motif</th>
        <th>Statut</th>
        <th>Actions</th>
    </tr>

    @foreach (var item in Model)
    {
        var demandeurNom = item.Utilisateur?.Enseignant != null
            ? $"{item.Utilisateur.Enseignant.PrenomEnseignant} {item.Utilisateur.Enseignant.NomEnseignant}"
            : item.Utilisateur?.Email ?? "Inconnu";

        <tr>
            <td>@item.IdReservation</td
            <td>@item.DateReservation.ToString("dd/MM/yyyy")</td
            <td>@item.HeureDebut.ToString(@"hh\:mm") - @item.HeureFin.ToString(@"hh\:mm")</td
            <td>@item.Salle?.NomSalle</td
            <td>@demandeurNom</td
            <td>@(item.Club?.NomClub ?? "-")</td
            <td>@(item.Motif?.Length > 30 ? item.Motif.Substring(0, 30) + "..." : item.Motif)</td
            <td>@(item.Statut == "validee" ? "Validée" : item.Statut == "en_attente" ? "En attente" : "Annulée")</td
            <td>
                <a href="/Reservations/Details/@item.IdReservation">Détails</a>
                |
                <a href="/Reservations/Edit/@item.IdReservation">Modifier</a>
                |
                <a href="/Reservations/Delete/@item.IdReservation">Supprimer</a>

                @* BOUTONS RÉSERVÉS À LA SCOLARITÉ *@
                @if (User.Identity.IsAuthenticated && User.IsInRole("scolarite"))
                {
                    if (item.Statut == "en_attente")
                    {
                        <text> | </text>
                        <form asp-action="Valider" asp-route-id="@item.IdReservation" method="post" style="display: inline;" onsubmit="return confirm('Valider cette réservation ?')">
                            @Html.AntiForgeryToken()
                            <button type="submit" style="background: none; border: none; padding: 0; cursor: pointer; color: blue; text-decoration: underline;">Valider</button>
                        </form>
                    }

                    if (item.Statut != "annulee")
                    {
                        <text> | </text>
                        <form asp-action="Annuler" asp-route-id="@item.IdReservation" method="post" style="display: inline;" onsubmit="return confirm('Annuler cette réservation ?')">
                            @Html.AntiForgeryToken()
                            <button type="submit" style="background: none; border: none; padding: 0; cursor: pointer; color: blue; text-decoration: underline;">Annuler</button>
                        </form>
                    }
                }
             </td
        </tr>
    }
</table>