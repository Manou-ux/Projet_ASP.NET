@model GESTION_S_E.Models.Classe

<h1>Supprimer une classe</h1>

<div style="background-color: #ffcccc; padding: 15px; border-radius: 5px;">
    <p>Êtes-vous sûr de vouloir supprimer cette classe ?</p>

    @if (Model != null)
    {
        <div>
            <strong>ID:</strong> @Model.IdClasse
        </div>
        <div>
            <strong>Nom:</strong> @Model.NomClasse
        </div>
        <div>
            <strong>Niveau:</strong> @Model.Niveau
        </div>
        <div>
            <strong>Filière:</strong> @Model.Filiere
        </div>
        <div>
            <strong>Effectif:</strong> @Model.Effectif
        </div>
        <div>
            <strong>Année académique:</strong> @Model.AnneeAcademique
        </div>
    }

    <br />

    <form method="post" action="/Classes/Delete/@Model?.IdClasse">
        @Html.AntiForgeryToken()  <!-- ← AJOUTEZ CETTE LIGNE -->
        <button type="submit" style="background-color: red; color: white;">Confirmer la suppression</button>
        <a href="/Classes/Index">Annuler</a>
    </form>
</div>