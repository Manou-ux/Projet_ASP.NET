@model List<GESTION_S_E.Models.Classe>

<h1>Liste des classes</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

<p>
    <a class="btn btn-primary" href="/Classes/Create">Ajouter une classe</a>
</p>

<div class="table-responsive">
    <table class="table table-striped table-bordered align-middle">
        <thead class="table-light">
            <tr>
                <th>ID</th>
                <th>Nom Classe</th>
                <th>Niveau</th>
                <th>Filière</th>
                <th>Effectif</th>
                <th>Année académique</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var classe in Model)
            {
                <tr>
                    <td>@classe.IdClasse</td>
                    <td>@classe.NomClasse</td>
                    <td>@classe.Niveau</td>
                    <td>@classe.Filiere</td>
                    <td>@classe.Effectif</td>
                    <td>@classe.AnneeAcademique</td>
                    <td class="text-end">
                        <div class="table-actions d-inline-flex gap-1">
                            
                            <a class="btn btn-sm btn-outline-secondary" href="/Classes/Edit/@classe.IdClasse">Modifier</a>
                            <a class="btn btn-sm btn-outline-danger" href="/Classes/Delete/@classe.IdClasse">Supprimer</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>