@model GESTION_S_E.Models.Scolarite

@{
    ViewData["Title"] = "Ajouter un agent de scolarité";
}

<h1>Ajouter un agent de scolarité</h1>

<form method="post">
    @Html.AntiForgeryToken()

    <div>
        <label>Nom *</label><br />
        <input type="text" name="NomScolarite" required style="width: 300px;" />
    </div>
    <br />

    <div>
        <label>Prénom *</label><br />
        <input type="text" name="PrenomScolarite" required style="width: 300px;" />
    </div>
    <br />

    <div>
        <label>Fonction</label><br />
        <input type="text" name="Fonction" style="width: 300px;" placeholder="Ex: Chef de scolarité, Agent..." />
    </div>
    <br />

    <div>
        <label>Téléphone</label><br />
        <input type="text" name="Telephone" style="width: 200px;" />
    </div>
    <br />

    <div>
        <label>Bureau</label><br />
        <input type="text" name="Bureau" style="width: 200px;" placeholder="Ex: B101" />
    </div>
    <br />

    <div>
        <label>ID Utilisateur</label><br />
        <input type="number" name="IdUtilisateur" />
    </div>
    <br />

    <button type="submit">Enregistrer</button>
    <a href="/Scolarites/Index">Annuler</a>
</form>