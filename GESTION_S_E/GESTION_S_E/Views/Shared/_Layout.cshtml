<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gestion Scolaire</title>
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    
    <!-- Custom CSS -->
    <style>
        body {
            background-color: #f8f9fa;
            padding-bottom: 60px;
        }
        
        .navbar-brand {
            font-weight: bold;
        }
        
        .card {
            transition: transform 0.2s;
        }
        
        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }
        
        .footer {
            position: fixed;
            bottom: 0;
            width: 100%;
            background-color: #f8f9fa;
            text-align: center;
            padding: 10px;
            font-size: 14px;
            z-index: 1000;
        }
        
        .main-content {
            margin-bottom: 60px;
            min-height: calc(100vh - 120px);
        }
        
        .user-info {
            color: white;
            margin-right: 15px;
        }
        
        .dropdown-menu {
            min-width: 220px;
        }
        
        /* Style pour les sous-menus dropdown */
        .dropdown-submenu {
            position: relative;
        }
        
        .dropdown-submenu .dropdown-menu {
            top: 0;
            left: 100%;
            margin-top: -1px;
            margin-left: 0;
        }
        
        /* Pour les menus à droite (dropdown-menu-end) */
        .dropdown-submenu.dropstart .dropdown-menu {
            left: auto;
            right: 100%;
            margin-left: 0;
            margin-right: 0;
        }
        
        .dropdown-submenu:hover > .dropdown-menu {
            display: block;
        }
        
        .dropdown-submenu > a:after {
            display: inline-block;
            margin-left: auto;
            content: "▶";
            font-size: 10px;
            float: right;
        }
        
        .dropdown-submenu.dropstart > a:after {
            content: "◀";
        }
        
        .dropdown-submenu:hover > a:after {
            border-left-color: #fff;
        }
        
        .dropdown-submenu .dropdown-item {
            cursor: pointer;
        }
        
        /* Version mobile */
        @@media (max-width: 768px) {
            .dropdown-submenu .dropdown-menu {
                position: static;
                float: none;
                width: auto;
                margin-top: 0;
                background-color: transparent;
                border: 0;
                box-shadow: none;
                padding-left: 20px;
            }
            
            .dropdown-submenu > a:after {
                content: "▼";
            }
            
            .dropdown-submenu.dropstart > a:after {
                content: "▼";
            }
            
            .dropdown-submenu:hover > .dropdown-menu {
                display: none;
            }
        }
    </style>
</head>
<body>
    <!-- Navigation Bar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="/Dashboard/Index">
                <i class="fas fa-school"></i> Gestion EMIT
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/Classes/Index">
                            <i class="fas fa-users"></i> Classes
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Salles/Index">
                            <i class="fas fa-door-open"></i> Salles
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Matieres/Index">
                            <i class="fas fa-book"></i> Matières
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Groupes/Index">
                            <i class="fas fa-layer-group"></i> Groupes
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/EmploiDuTemps/Index">
                            <i class="fas fa-calendar-alt"></i> Emploi du temps
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Reservations/Index">
                            <i class="fas fa-bookmark"></i> Réservations
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Clubs/Index">
                            <i class="fas fa-flag"></i> Clubs
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Disponibilites/Index">
                            <i class="fas fa-clock"></i> Disponibilités
                        </a>
                    </li>
                </ul>
                
                <!-- Section utilisateur et déconnexion -->
                <ul class="navbar-nav ms-auto">
                    @if (User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown">
                                <i class="fas fa-user-circle"></i> @User.Identity.Name
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <a class="dropdown-item" href="/Account/Profile">
                                        <i class="fas fa-id-card"></i> Mon profil
                                    </a>
                                </li>
                                
                                <!-- Gérer les utilisateurs avec sous-menu -->
                                <li class="dropdown-submenu dropstart">
                                    <a class="dropdown-item dropdown-toggle" href="#">
                                        <i class="fas fa-users-gear"></i> Gérer les utilisateurs
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li>
                                            <a class="dropdown-item" href="/Eleves/Index">
                                                <i class="fas fa-user-graduate"></i> Élèves
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" href="/Enseignants/Index">
                                                <i class="fas fa-chalkboard-user"></i> Enseignants
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" href="/Scolarites/Index">
                                                <i class="fas fa-building"></i> Scolarité
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                                
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item text-danger" href="/Account/Logout">
                                        <i class="fas fa-sign-out-alt"></i> Déconnexion
                                    </a>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link btn btn-primary text-white" href="/Account/Login">
                                <i class="fas fa-sign-in-alt"></i> Connexion
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="container main-content mt-4">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <!-- Footer -->
    <footer class="footer border-top">
        <div class="container">
            <i class="fas fa-calendar-alt"></i> Gestion des Emplois du Temps & Salles
            &copy; 2025 EMIT - Tous droits réservés
        </div>
    </footer>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Script pour gérer les sous-menus sur mobile -->
    <script>
        // Pour mobile : permettre l'ouverture des sous-menus au clic
        $(document).ready(function() {
            if ($(window).width() <= 768) {
                $('.dropdown-submenu a.dropdown-toggle').on('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    $(this).next('.dropdown-menu').toggle();
                });
            }
        });
    </script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>