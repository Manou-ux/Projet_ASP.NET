<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gestion EMIT</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    
    <style>
        body { background-color: #f8f9fa; padding-bottom: 60px; }
        .navbar-brand { font-weight: bold; }
        .card { transition: transform 0.2s; }
        .card:hover { transform: translateY(-5px); box-shadow: 0 4px 15px rgba(0,0,0,0.1); }
        .footer { position: fixed; bottom: 0; width: 100%; background-color: #f8f9fa; text-align: center; padding: 10px; font-size: 14px; z-index: 1000; }
        .main-content { margin-bottom: 60px; min-height: calc(100vh - 120px); }
        .dropdown-menu { min-width: 220px; }
        .dropdown-submenu { position: relative; }
        .dropdown-submenu .dropdown-menu { top: 0; left: 100%; margin-top: -1px; margin-left: 0; }
        .dropdown-submenu.dropstart .dropdown-menu { left: auto; right: 100%; }
        .dropdown-submenu:hover > .dropdown-menu { display: block; }
        .dropdown-submenu > a:after { display: inline-block; margin-left: auto; content: "▶"; font-size: 10px; float: right; }
        .dropdown-submenu.dropstart > a:after { content: "◀"; }
        @@media (max-width: 991.98px) {
            .dropdown-submenu .dropdown-menu { position: static; float: none; width: auto; background-color: transparent; border: 0; box-shadow: none; padding-left: 20px; }
            .dropdown-submenu > a:after { content: "▼"; }
            .dropdown-submenu.dropstart > a:after { content: "▼"; }
            .dropdown-submenu:hover > .dropdown-menu { display: none; }
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand d-inline-flex align-items-center gap-2" href="/Dashboard/Index">
                <i class="fas fa-school"></i> <span>Gestion EMIT</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    @if (User.Identity.IsAuthenticated)
                    {
                        // ---------- SCOLARITÉ ----------
                        if (User.IsInRole("scolarite"))
                        {
                            <li class="nav-item"><a class="nav-link" href="/EmploiDuTemps/Index">Tous les EDT</a></li>
                            <li class="nav-item"><a class="nav-link" href="/Classes/Index">Classes</a></li>
                            <li class="nav-item"><a class="nav-link" href="/Salles/Index">Salles</a></li>
                            <li class="nav-item"><a class="nav-link" href="/Matieres/Index">Matières</a></li>
                            <li class="nav-item"><a class="nav-link" href="/Groupes/Index">Groupes</a></li>
                            <li class="nav-item"><a class="nav-link" href="/Enseignants/Index">Enseignants</a></li>
                            <li class="nav-item"><a class="nav-link" href="/Reservations/Index">Réservations</a></li>
                            <li class="nav-item"><a class="nav-link" href="/Clubs/Index">Clubs</a></li>
                            <li class="nav-item"><a class="nav-link" href="/Disponibilites/Index">Disponibilités</a></li>
                        }

                        // ---------- PROFESSEUR ----------
                        if (User.IsInRole("enseignant"))
                        {
                            <li class="nav-item"><a class="nav-link" href="/EmploiDuTemps/WeeklyView">Mon emploi du temps</a></li>
                            <li class="nav-item"><a class="nav-link" href="/Disponibilites/Index">Mes disponibilités</a></li>
                            <li class="nav-item"><a class="nav-link" href="/Reservations/Index">Réservations</a></li>
                        }

                        // ---------- ÉTUDIANT ----------
                        if (User.IsInRole("eleve"))
                        {
                            <li class="nav-item"><a class="nav-link" href="/EmploiDuTemps/WeeklyView">Mon emploi du temps</a></li>
                            @await Component.InvokeAsync("ClubResponsable")
                        }
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" href="/Account/Login">Connexion</a></li>
                    }
                </ul>

                <ul class="navbar-nav ms-auto">
                    @if (User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown">
                                <i class="fas fa-user-circle"></i> @User.Identity.Name
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="/Account/Profile">Mon profil</a></li>
                                @if (User.IsInRole("scolarite"))
                                {
                                    <li class="dropdown-submenu dropstart">
                                        <a class="dropdown-item dropdown-toggle" href="#">Gérer les utilisateurs</a>
                                        <ul class="dropdown-menu">
                                            <li><a class="dropdown-item" href="/Eleves/Index">Élèves</a></li>
                                            <li><a class="dropdown-item" href="/Enseignants/Index">Enseignants</a></li>
                                            <li><a class="dropdown-item" href="/Scolarites/Index">Scolarité</a></li>
                                        </ul>
                                    </li>
                                }
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item text-danger" href="/Account/Logout">Déconnexion</a></li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link btn btn-primary text-white" href="/Account/Login">Connexion</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="container main-content mt-4">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="footer border-top">
        <div class="container">Gestion des Emplois du Temps & Salles &copy; 2026 EMIT</div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        $(document).ready(function() {
            $('.dropdown-submenu a.dropdown-toggle').on('click', function(e) {
                if ($(window).width() <= 991.98) {
                    e.preventDefault();
                    e.stopPropagation();
                    $(this).next('.dropdown-menu').toggle();
                }
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>