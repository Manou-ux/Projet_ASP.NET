<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gestion Scolaire</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    
    <style>
        body {
            background-color: #f8f9fa;
            padding-bottom: 60px;
        }
        
        .navbar-brand {
            font-weight: bold;
        }
        
        .card {
            transition: transform 0.2s;
        }
        
        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }
        
        .footer {
            position: fixed;
            bottom: 0;
            width: 100%;
            background-color: #f8f9fa;
            text-align: center;
            padding: 10px;
            font-size: 14px;
            z-index: 1000;
        }
        
        .main-content {
            margin-bottom: 60px;
            min-height: calc(100vh - 120px);
        }
        
        .user-info {
            color: white;
            margin-right: 15px;
        }
        
        .dropdown-menu {
            min-width: 220px;
        }
        
        /* Style pour les sous-menus dropdown */
        .dropdown-submenu {
            position: relative;
        }
        
        .dropdown-submenu .dropdown-menu {
            top: 0;
            left: 100%;
            margin-top: -1px;
            margin-left: 0;
        }
        
        /* Pour les menus à droite (dropdown-menu-end) */
        .dropdown-submenu.dropstart .dropdown-menu {
            left: auto;
            right: 100%;
            margin-left: 0;
            margin-right: 0;
        }
        
        .dropdown-submenu:hover > .dropdown-menu {
            display: block;
        }
        
        .dropdown-submenu > a:after {
            display: inline-block;
            margin-left: auto;
            content: "▶";
            font-size: 10px;
            float: right;
        }
        
        .dropdown-submenu.dropstart > a:after {
            content: "◀";
        }
        
        .dropdown-submenu:hover > a:after {
            border-left-color: #fff;
        }
        
        .dropdown-submenu .dropdown-item {
            cursor: pointer;
        }
        
        /* Version mobile */
        @@media (max-width: 991.98px) {
            .dropdown-submenu .dropdown-menu {
                position: static;
                float: none;
                width: auto;
                margin-top: 0;
                background-color: transparent;
                border: 0;
                box-shadow: none;
                padding-left: 20px;
            }
            
            .dropdown-submenu > a:after {
                content: "▼";
            }
            
            .dropdown-submenu.dropstart > a:after {
                content: "▼";
            }
            
            .dropdown-submenu:hover > .dropdown-menu {
                display: none;
            }
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand d-inline-flex align-items-center gap-2" href="/Dashboard/Index">
                <i class="fas fa-school"></i> <span>Gestion EMIT</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link d-inline-flex align-items-center gap-2" href="/Classes/Index">
                            <i class="fas fa-users"></i> <span>Classes</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link d-inline-flex align-items-center gap-2" href="/Salles/Index">
                            <i class="fas fa-door-open"></i> <span>Salles</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link d-inline-flex align-items-center gap-2" href="/Matieres/Index">
                            <i class="fas fa-book"></i> <span>Matières</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link d-inline-flex align-items-center gap-2" href="/Groupes/Index">
                            <i class="fas fa-layer-group"></i> <span>Groupes</span>
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link d-inline-flex align-items-center gap-2" href="/Reservations/Index">
                            <i class="fas fa-bookmark"></i> <span>Réservations</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link d-inline-flex align-items-center gap-2" href="/Clubs/Index">
                            <i class="fas fa-flag"></i> <span>Clubs</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link d-inline-flex align-items-center gap-2" href="/Disponibilites/Index">
                            <i class="fas fa-clock"></i> <span>Disponibilités</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link d-inline-flex align-items-center gap-2" href="/EmploiDuTemps/Index">
                            <i class="fas fa-calendar-alt"></i> <span>Emploi du temps</span>
                        </a>
                    </li>
                </ul>

                
                <ul class="navbar-nav ms-auto">
                    @if (User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-inline-flex align-items-center gap-2" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown">
                                <i class="fas fa-user-circle"></i> <span>@User.Identity.Name</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <a class="dropdown-item d-inline-flex align-items-center gap-2" href="/Account/Profile">
                                        <i class="fas fa-id-card"></i> <span>Mon profil</span>
                                    </a>
                                </li>
                                
                                <li class="dropdown-submenu dropstart">
                                    <a class="dropdown-item dropdown-toggle d-inline-flex align-items-center gap-2" href="#">
                                        <i class="fas fa-users-gear"></i> <span>Gérer les utilisateurs</span>
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li>
                                            <a class="dropdown-item d-inline-flex align-items-center gap-2" href="/Eleves/Index">
                                                <i class="fas fa-user-graduate"></i> <span>Élèves</span>
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item d-inline-flex align-items-center gap-2" href="/Enseignants/Index">
                                                <i class="fas fa-chalkboard-user"></i> <span>Enseignants</span>
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item d-inline-flex align-items-center gap-2" href="/Scolarites/Index">
                                                <i class="fas fa-building"></i> <span>Scolarité</span>
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                                
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item text-danger d-inline-flex align-items-center gap-2" href="/Account/Logout">
                                        <i class="fas fa-sign-out-alt"></i> <span>Déconnexion</span>
                                    </a>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link btn btn-primary text-white d-inline-flex align-items-center gap-2" href="/Account/Login">
                                <i class="fas fa-sign-out-alt"></i> <span>Connexion</span>
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="container main-content mt-4">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="footer border-top">
        <div class="container d-flex align-items-center justify-content-center gap-2 flex-wrap">
            <i class="fas fa-calendar-alt"></i> 
            <span>Gestion des Emplois du Temps & Salles &copy; 2026 EMIT - Tous droits réservés</span>
        </div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    
    <script>
        $(document).ready(function() {
            // Utilisation d'une fonction réutilisable pour vérifier la taille à l'exécution
            $('.dropdown-submenu a.dropdown-toggle').on('click', function(e) {
                if ($(window).width() <= 991.98) {
                    e.preventDefault();
                    e.stopPropagation();
                    $(this).next('.dropdown-menu').toggle();
                }
            });
        });
    </script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>