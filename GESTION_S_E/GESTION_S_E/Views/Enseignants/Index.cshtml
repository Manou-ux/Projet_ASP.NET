@model List<GESTION_S_E.Models.Enseignant>

@{
    ViewData["Title"] = "Gestion des enseignants";
}

<h1>Liste des enseignants</h1>

@if (TempData["Success"] != null)
{
    <div style="background-color: green; color: white; padding: 10px; margin-bottom: 20px;">
        @TempData["Success"]
    </div>
}




<div class="table-responsive mt-3">
    <table class="table table-striped table-bordered align-middle">
        <thead class="table-light">
            <tr>
                <th>ID</th>
                <th>Nom</th>
                <th>Prénom</th>
                <th>Spécialité</th>
                <th>Téléphone</th>
                <th>Email pro</th>
                <th>ID Utilisateur</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var enseignant in Model)
            {
                <tr>
                    <td>@enseignant.IdEnseignant</td>
                    <td>@enseignant.NomEnseignant</td>
                    <td>@enseignant.PrenomEnseignant</td>
                    <td>@enseignant.Specialite</td>
                    <td>@enseignant.TelephoneEnseignant</td>
                    <td>@enseignant.EmailPro</td>
                    <td>@enseignant.IdUtilisateur</td>
                    <td class="text-end">
                        <div class="table-actions d-inline-flex gap-1">
                            <a class="btn btn-sm btn-outline-primary" href="/Enseignants/Details/@enseignant.IdEnseignant">Détails</a>
                            <a class="btn btn-sm btn-outline-secondary" href="/Enseignants/Edit/@enseignant.IdEnseignant">Modifier</a>
                            <a class="btn btn-sm btn-outline-danger" href="/Enseignants/Delete/@enseignant.IdEnseignant">Supprimer</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>