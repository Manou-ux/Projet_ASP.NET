@model GESTION_S_E.Models.Enseignant

@{
    ViewData["Title"] = "Ajouter un enseignant";
}

<h1>Ajouter un enseignant</h1>

<form method="post">
    @Html.AntiForgeryToken()

    <div>
        <label>Nom *</label><br />
        <input type="text" name="NomEnseignant" required style="width: 300px;" />
    </div>
    <br />

    <div>
        <label>Prénom *</label><br />
        <input type="text" name="PrenomEnseignant" required style="width: 300px;" />
    </div>
    <br />

    <div>
        <label>Spécialité</label><br />
        <input type="text" name="Specialite" style="width: 300px;" />
    </div>
    <br />

    <div>
        <label>Téléphone</label><br />
        <input type="text" name="TelephoneEnseignant" style="width: 200px;" />
    </div>
    <br />

    <div>
        <label>Email professionnel</label><br />
        <input type="email" name="EmailPro" style="width: 300px;" />
    </div>
    <br />

    <div>
        <label>ID Utilisateur</label><br />
        <input type="number" name="IdUtilisateur" />
    </div>
    <br />

    <button type="submit">Enregistrer</button>
    <a href="/Enseignants/Index">Annuler</a>
</form>