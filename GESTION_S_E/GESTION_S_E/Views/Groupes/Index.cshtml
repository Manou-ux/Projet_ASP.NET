@model List<GESTION_S_E.Models.Groupe>

<h1>Liste des groupes</h1>

@if (TempData["Success"] != null)
{
    <div style="background-color: green; color: white; padding: 15px; margin-bottom: 20px; border-radius: 5px;">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div style="background-color: red; color: white; padding: 15px; margin-bottom: 20px; border-radius: 5px;">
        @TempData["Error"]
    </div>
}

<p>
    <a class="btn btn-primary" href="/Groupes/Create">Ajouter un groupe</a>
</p>

@if (Model != null && Model.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Nom du groupe</th>
                    <th>Classe</th>
                    <th>Niveau</th>
                    <th>Filière</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var groupe in Model)
                {
                    <tr>
                        <td>@groupe.IdGroupe</td>
                        <td>@groupe.NomGroupe</td>
                        <td>@groupe.Classe?.NomClasse</td>
                        <td>@groupe.Classe?.Niveau</td>
                        <td>@groupe.Classe?.Filiere</td>
                        <td class="text-end">
                            <div class="table-actions d-inline-flex gap-1">
                                <a class="btn btn-sm btn-outline-primary" href="/Groupes/Details/@groupe.IdGroupe">Détails</a>
                                <a class="btn btn-sm btn-outline-secondary" href="/Groupes/Edit/@groupe.IdGroupe">Modifier</a>
                                <a class="btn btn-sm btn-outline-danger" href="/Groupes/Delete/@groupe.IdGroupe">Supprimer</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <p>Aucun groupe trouvé. Cliquez sur "Ajouter un groupe" pour créer le premier groupe.</p>
}