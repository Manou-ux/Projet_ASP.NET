@{
    ViewData["Title"] = "Dashboard - Gestion EMIT";
}

<style>
    body {
        font-family: 'DM Sans', sans-serif;
        background-color: #ffffff;
        color: #0f172a;
        padding: 30px 20px;
    }

    /* Minimal Stat Card */
    .stat-card {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        text-decoration: none;
        color: inherit;
        transition: border-color 0.15s ease, background-color 0.15s ease;
    }
    .stat-card:hover {
        border-color: #0f172a;
        background-color: #ffffff;
        color: inherit;
    }
    .stat-card h5 {
        font-size: 12px;
        font-weight: 500;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin: 0 0 4px;
    }
    .stat-card h2 {
        font-size: 28px;
        font-weight: 600;
        color: #0f172a;
        margin: 0;
        letter-spacing: -0.5px;
    }
    .stat-card-icon {
        font-size: 20px;
        color: #94a3b8;
    }

    /* Minimal Admin Card */
    .admin-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 24px;
        height: 100%;
        display: flex;
        flex-direction: column;
        transition: border-color 0.15s ease;
    }
    .admin-card:hover {
        border-color: #0f172a;
    }
    .admin-card h5 {
        font-size: 15px;
        font-weight: 600;
        color: #0f172a;
        margin: 0 0 6px;
    }
    .admin-card p {
        font-size: 13px;
        color: #64748b;
        margin: 0 0 20px;
        flex-grow: 1;
    }
    .btn-access {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 14px;
        background: #0f172a;
        color: #ffffff;
        border-radius: 6px;
        font-size: 13px;
        font-weight: 500;
        text-decoration: none;
        width: fit-content;
        transition: background-color 0.15s ease;
    }
    .btn-access:hover { background: #1e293b; color: #ffffff; }

    /* Quick Links */
    .quick-link {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 16px;
        text-align: center;
        text-decoration: none;
        color: #0f172a;
        font-size: 13px;
        font-weight: 500;
        transition: all 0.15s ease;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
    }
    .quick-link i {
        font-size: 18px;
        color: #64748b;
    }
    .quick-link:hover {
        border-color: #0f172a;
        background: #ffffff;
        color: #0f172a;
    }
    .quick-link:hover i { color: #0f172a; }

    /* Section Label */
    .section-label {
        font-size: 11px;
        font-weight: 600;
        color: #94a3b8;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        margin-top: 35px;
        margin-bottom: 16px;
    }
</style>

<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet">

<div class="container-fluid px-0">
    
    <div class="d-flex align-items-center gap-3 border-bottom pb-4 mb-4">
        <div class="text-dark" style="font-size: 28px;"><i class="fas fa-school"></i></div>
        <div>
            <h1 class="h4 fw-semibold m-0">Dashboard EMIT</h1>
            <p class="text-muted small m-0">Système de gestion des salles, emplois du temps et clubs</p>
        </div>
    </div>

    <p class="section-label mt-0">Vue d'ensemble</p>
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-5 g-3">
        <div class="col">
            <a href="/Salles/Index" class="stat-card">
                <div>
                    <h5>Salles</h5>
                    <h2>@ViewBag.TotalSalles</h2>
                </div>
                <div class="stat-card-icon"><i class="fas fa-door-open"></i></div>
            </a>
        </div>

        <div class="col">
            <a href="/Classes/Index" class="stat-card">
                <div>
                    <h5>Classes</h5>
                    <h2>@ViewBag.TotalClasses</h2>
                </div>
                <div class="stat-card-icon"><i class="fas fa-users"></i></div>
            </a>
        </div>

        <div class="col">
            <a href="/Matieres/Index" class="stat-card">
                <div>
                    <h5>Matières</h5>
                    <h2>@ViewBag.TotalMatieres</h2>
                </div>
                <div class="stat-card-icon"><i class="fas fa-book"></i></div>
            </a>
        </div>

        <div class="col">
            <a href="/Reservations/Index" class="stat-card">
                <div>
                    <h5>Réservations</h5>
                    <h2>@ViewBag.TotalReservations</h2>
                </div>
                <div class="stat-card-icon"><i class="fas fa-bookmark"></i></div>
            </a>
        </div>

        <div class="col">
            <a href="/Clubs/Index" class="stat-card">
                <div>
                    <h5>Clubs</h5>
                    <h2>@ViewBag.TotalClubs</h2>
                </div>
                <div class="stat-card-icon"><i class="fas fa-flag"></i></div>
            </a>
        </div>
    </div>

    <p class="section-label">Administration des utilisateurs</p>
    <div class="row g-3">
        <div class="col-12 col-md-4">
            <div class="admin-card">
                <h5>Gestion des Élèves</h5>
                <p>Consulter, ajouter, modifier ou supprimer les élèves</p>
                <a href="/Eleves/Index" class="btn-access">
                    Accéder <i class="fas fa-arrow-right small ms-1"></i>
                </a>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="admin-card">
                <h5>Gestion des Enseignants</h5>
                <p>Consulter, ajouter, modifier ou supprimer les enseignants</p>
                <a href="/Enseignants/Index" class="btn-access">
                    Accéder <i class="fas fa-arrow-right small ms-1"></i>
                </a>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="admin-card">
                <h5>Gestion Scolarité</h5>
                <p>Consulter, ajouter, modifier ou supprimer le personnel scolarité</p>
                <a href="/Scolarites/Index" class="btn-access">
                    Accéder <i class="fas fa-arrow-right small ms-1"></i>
                </a>
            </div>
        </div>
    </div>

    <p class="section-label">Activités parascolaires</p>
    <div class="row g-3">
        <div class="col-12 col-md-6">
            <div class="admin-card">
                <h5>Gestion des Clubs</h5>
                <p>Consulter, ajouter, modifier ou supprimer les clubs</p>
                <a href="/Clubs/Index" class="btn-access">
                    Accéder aux clubs <i class="fas fa-arrow-right small ms-1"></i>
                </a>
            </div>
        </div>
        <div class="col-12 col-md-6">
            <div class="admin-card">
                <h5>Membres des Clubs</h5>
                <p>Gérer les adhésions, les rôles et la participation des membres</p>
                <a href="/Clubs/Index" class="btn-access">
                    Gérer les membres <i class="fas fa-arrow-right small ms-1"></i>
                </a>
            </div>
        </div>
    </div>

    <p class="section-label">Navigation rapide</p>
    <div class="row row-cols-2 row-cols-sm-3 row-cols-md-5 g-2">
        <div class="col">
            <a href="/Groupes/Index" class="quick-link">
                <i class="fas fa-layer-group"></i> Groupes
            </a>
        </div>
        <div class="col">
            <a href="/EmploiDuTemps/Index" class="quick-link">
                <i class="fas fa-calendar-alt"></i> EDT
            </a>
        </div>
        <div class="col">
            <a href="/Reservations/Index" class="quick-link">
                <i class="fas fa-bookmark"></i> Réservations
            </a>
        </div>
        <div class="col">
            <a href="/Clubs/Index" class="quick-link">
                <i class="fas fa-flag"></i> Clubs
            </a>
        </div>
        <div class="col">
            <a href="/Account/Profile" class="quick-link">
                <i class="fas fa-user-circle"></i> Mon profil
            </a>
        </div>
    </div>
</div>